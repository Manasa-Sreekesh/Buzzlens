# Copy this file to .env and fill in your own keys. .env is gitignored and
# never committed. Every key here is YOURS — nothing is shared, and each is
# only ever sent to its own official API to make the request it's needed for.
#
# You don't need every key up front — search.js checks what a given source
# needs at the moment you use it and reports exactly what's missing.

# ------------------------------------------------------------------
# YouTube Data API v3 — required to collect real YouTube comments.
# Get one: https://console.cloud.google.com
#   -> APIs & Services -> Library -> "YouTube Data API v3" -> Enable
#   -> APIs & Services -> Credentials -> Create API Key
# Free quota: 10,000 units/day (one search costs roughly 100-150 units).
# ------------------------------------------------------------------
YOUTUBE_API_KEY=

# ------------------------------------------------------------------
# Reddit — no credentials required by default (public read-only JSON
# endpoints, subject to stricter unauthenticated rate limits).
#
# Optional: add a "script" app's client id/secret for higher rate limits.
# Get one: https://www.reddit.com/prefs/apps -> "create app" -> script
# ------------------------------------------------------------------
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=buzzlens-skill/0.1 (local research tool)

# ------------------------------------------------------------------
# Twitter / X API v2 Bearer Token — required to collect real tweets.
# IMPORTANT: recent-search access requires a PAID X API tier (the free tier
# does not include search). If your token's tier doesn't have search
# access, search.js reports that clearly and skips Twitter/X — it will
# never substitute fake tweets.
# Get one: https://developer.twitter.com/en/portal/dashboard
# ------------------------------------------------------------------
TWITTER_BEARER_TOKEN=

# ------------------------------------------------------------------
# Community site (any forum/review/blog URL you point --community-urls at)
# — no credentials required. A realistic desktop-Chrome User-Agent is used
# by default, which works for most sites.
#
# Optional: override the User-Agent for a specific site that blocks the
# default but allows something else. This will NOT bypass Cloudflare-style
# JS-challenge/bot-detection — those still surface as a clear HTTP error.
# ------------------------------------------------------------------
COMMUNITY_USER_AGENT=

# ------------------------------------------------------------------
# Local dashboard server port (optional). dashboard.js tries the next port
# automatically if this one is already in use.
# ------------------------------------------------------------------
DASHBOARD_PORT=4173
